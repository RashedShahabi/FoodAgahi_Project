// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TransactionType {
  WALLET_CHARGE
  FOOD_PURCHASE
  FOOD_SALE
  WITHDRAWAL
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MealType {
  LUNCH
  DINNER
}

enum AdStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       String   @id @default(cuid())
  mobile   String   @unique
  password String
  role     UserRole @default(STUDENT)
  isActive Boolean  @default(true)

  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?

  balance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentIds     StudentId[]
  ibans          Iban[]
  otpCodes       OtpCode[]
  foodAds        FoodAd[]
  purchaseOrders Order[]       @relation("Buyer")
  saleOrders     Order[]       @relation("Seller")
  transactions   Transaction[]
  warnings       Warning[]

  // ✅ اضافه شد (برای Report)
  reports Report[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(cuid())
  mobile    String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mobile])
  @@index([expiresAt])
  @@map("otp_codes")
}

model StudentId {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentNumber String

  createdAt DateTime @default(now())

  @@unique([userId, studentNumber])
  @@index([userId])
  @@map("student_ids")
}

model Iban {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ibanNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, ibanNumber])
  @@index([userId])
  @@map("ibans")
}

model FoodAd {
  id       String @id @default(cuid())
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  foodName    String
  price       Float
  description String?
  imageUrl    String?
  mealType    MealType
  mealDate    DateTime

  status AdStatus @default(PENDING)

  isAvailable Boolean @default(true)
  isSold      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  orders Order[]

  // ✅ اضافه شد (برای Report)
  reports Report[]

  @@index([sellerId])
  @@index([mealDate])
  @@index([isAvailable])
  @@map("food_ads")
}

model Order {
  id String @id @default(cuid())

  buyerId String
  buyer   User   @relation("Buyer", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("Seller", fields: [sellerId], references: [id])

  foodAdId String
  foodAd   FoodAd @relation(fields: [foodAdId], references: [id])

  basePrice      Float
  buyerFee       Float
  sellerFee      Float
  totalPaid      Float
  sellerReceives Float
  platformProfit Float

  buyerStudentId String

  status OrderStatus @default(PENDING)

  transferScreenshot String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?

  transactions Transaction[]
  dispute      Dispute?

  @@index([buyerId])
  @@index([sellerId])
  @@index([foodAdId])
  @@index([status])
  @@map("orders")
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amount Float

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  description       String?
  paymentGatewayRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@map("transactions")
}

model Dispute {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  buyerReason    String
  sellerResponse String?

  adminDecision     String?
  resolvedInFavorOf String?

  isResolved Boolean @default(false)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([orderId])
  @@index([isResolved])
  @@map("disputes")
}

model Warning {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  reason      String
  description String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("warnings")
}

// ادمین
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  foodAdId String
  foodAd   FoodAd @relation(fields: [foodAdId], references: [id])

  reason      String
  description String?

  isResolved Boolean @default(false)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([reporterId])
  @@index([foodAdId])
  @@map("reports")
}

model Banner {
  id String @id @default(cuid())

  title    String
  imageUrl String
  link     String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}
